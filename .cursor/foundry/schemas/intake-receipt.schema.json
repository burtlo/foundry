{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/intake-receipt.schema.json",
  "title": "IntakeReceipt",
  "description": "Sealed intake evidence for a phase intake step: CLI checks, captured outputs, and agent assessment.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "timestamp",
    "step_id",
    "status",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.2.0" },
    "receipt_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "step_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["passed", "blocked", "failed"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
          "summary": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    },
    "agent_assessment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary_markdown": { "type": "string" },
        "blocked_reason": { "type": "string" }
      }
    },
    "inputs": { "type": "object" }
  }
}
