{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/agent-contract.schema.json",
  "title": "FoundryAgentContract",
  "description": "JSON Schema for a single worker capability contract file under .cursor/foundry/contracts/{worker}.yaml",
  "type": "object",
  "required": ["capabilities", "modes"],
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "write_scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_output_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["valid_next_states"],
        "additionalProperties": false,
        "properties": {
          "valid_next_states": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
