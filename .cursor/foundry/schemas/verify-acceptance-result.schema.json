{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/verify-acceptance-result.schema.json",
  "title": "VerifyAcceptanceResult",
  "description": "Validated semantic output from verify.acceptance implementation-validator judgment.",
  "type": "object",
  "required": ["summary", "gate_decision", "evidence_ok", "items"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "gate_decision": {
      "type": "string",
      "enum": ["pass", "replan", "reshape", "rework_execute"]
    },
    "evidence_ok": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status"],
        "additionalProperties": true,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["met", "not_met", "not_verified"]
          },
          "basis": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "gate_decision": { "const": "pass" } },
        "required": ["gate_decision"]
      },
      "then": {
        "properties": { "evidence_ok": { "const": true } }
      }
    }
  ]
}
