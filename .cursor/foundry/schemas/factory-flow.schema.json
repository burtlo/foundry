{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/factory-flow.schema.json",
  "title": "FactoryFlowRegistry",
  "description": "Workflow schema v1 registry (format version 2). Nodes own work or decisions; connections own all routing.",
  "type": "object",
  "required": ["version", "state_schema", "flow"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "state_schema": {
      "$ref": "#/$defs/registrySchemaPath"
    },
    "expression": {
      "$ref": "#/$defs/expressionDefinition"
    },
    "flow": {
      "$ref": "#/$defs/flowDefinition"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "artifactIdentifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "registryPath": {
      "type": "string",
      "pattern": "^registry:[^\\s]+$"
    },
    "registrySchemaPath": {
      "type": "string",
      "pattern": "^registry:schemas/[A-Za-z0-9._-]+\\.schema\\.json$"
    },
    "filePath": {
      "type": "string",
      "pattern": "^(registry:|workspace:)[^{}]*$|^run:(?:[^{}]*|[^{}]*\\{visit_id\\}[^{}]*)$"
    },
    "artifactUriTemplate": {
      "type": "string",
      "pattern": "^workspace:[^{}]+$|^run:(?:[^{}]+|[^{}]*\\{visit_id\\}[^{}]*)$"
    },
    "stringSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "expressionDefinition": {
      "type": "object",
      "required": ["namespaces", "operators"],
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "$ref": "#/$defs/stringSet"
        },
        "operators": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "flowDefinition": {
      "type": "object",
      "required": ["id", "entry", "checks", "nodes", "connections"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "entry": {
          "$ref": "#/$defs/identifier"
        },
        "checks": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/checkCatalogEntry"
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nodeDefinition"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connectionDefinition"
          }
        }
      }
    },
    "checkCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/filePath"
        }
      },
      "oneOf": [
        {
          "required": ["when"]
        },
        {
          "required": ["command"]
        },
        {
          "required": ["path"]
        }
      ]
    },
    "checkReferenceEarly": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/identifier"
        },
        "on_pass": {
          "$ref": "#/$defs/actionEarly"
        },
        "on_fail": {
          "$ref": "#/$defs/actionEarly"
        },
        "on_not_applicable": {
          "$ref": "#/$defs/actionEarly"
        }
      }
    },
    "checkReferenceClose": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/identifier"
        },
        "on_pass": {
          "$ref": "#/$defs/actionClose"
        },
        "on_fail": {
          "$ref": "#/$defs/actionClose"
        },
        "on_not_applicable": {
          "$ref": "#/$defs/actionClose"
        }
      }
    },
    "checkReferenceSeal": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/identifier"
        },
        "on_pass": {
          "$ref": "#/$defs/actionSeal"
        },
        "on_fail": {
          "$ref": "#/$defs/actionSeal"
        },
        "on_not_applicable": {
          "$ref": "#/$defs/actionSeal"
        }
      }
    },
    "actionInstance": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "continue",
            "satisfy",
            "skip",
            "reopen",
            "halt",
            "escalate",
            "disqualify"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["skip", "reopen", "halt", "escalate", "disqualify"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "required": ["reason"]
          }
        }
      ]
    },
    "actionEarly": {
      "allOf": [
        {
          "$ref": "#/$defs/actionInstance"
        },
        {
          "properties": {
            "action": {
              "enum": ["continue", "satisfy", "skip", "halt", "escalate", "disqualify"]
            }
          }
        }
      ]
    },
    "actionClose": {
      "allOf": [
        {
          "$ref": "#/$defs/actionInstance"
        },
        {
          "properties": {
            "action": {
              "enum": ["continue", "satisfy", "halt", "escalate", "disqualify"]
            }
          }
        }
      ]
    },
    "actionSeal": {
      "allOf": [
        {
          "$ref": "#/$defs/actionInstance"
        },
        {
          "properties": {
            "action": {
              "enum": ["continue", "satisfy", "reopen", "halt", "escalate", "disqualify"]
            }
          }
        }
      ]
    },
    "hookDefinitionEarly": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkReferenceEarly"
      }
    },
    "hookDefinitionClose": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkReferenceClose"
      }
    },
    "hookDefinitionSeal": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkReferenceSeal"
      }
    },
    "lifecycleHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_examine": {
          "$ref": "#/$defs/hookDefinitionEarly"
        },
        "on_open": {
          "$ref": "#/$defs/hookDefinitionEarly"
        },
        "on_close": {
          "$ref": "#/$defs/hookDefinitionClose"
        },
        "on_seal": {
          "$ref": "#/$defs/hookDefinitionSeal"
        }
      }
    },
    "documentArtifact": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactIdentifier"
        },
        "kind": {
          "const": "document"
        },
        "uri": {
          "$ref": "#/$defs/artifactUriTemplate"
        },
        "schema": {
          "$ref": "#/$defs/registrySchemaPath"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cardinality": {
          "type": "string",
          "enum": ["one", "many"],
          "default": "one"
        }
      }
    },
    "referenceArtifact": {
      "type": "object",
      "required": ["id", "kind", "scheme"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/artifactIdentifier"
        },
        "kind": {
          "const": "reference"
        },
        "scheme": {
          "$ref": "#/$defs/identifier"
        },
        "schema": {
          "$ref": "#/$defs/registrySchemaPath"
        },
        "cardinality": {
          "type": "string",
          "enum": ["one", "many"],
          "default": "one"
        }
      }
    },
    "artifactDeclaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/documentArtifact"
        },
        {
          "$ref": "#/$defs/referenceArtifact"
        }
      ]
    },
    "stepProduces": {
      "type": "object",
      "required": ["artifacts"],
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactDeclaration"
          }
        }
      }
    },
    "gateProduces": {
      "type": "object",
      "required": ["options"],
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "artifactRead": {
      "type": "object",
      "required": ["artifact", "from"],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "from": {
          "const": "nearest_sealed_ancestor"
        }
      }
    },
    "readsDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "$ref": "#/$defs/stringSet"
        },
        "state": {
          "$ref": "#/$defs/stringSet"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filePath"
          },
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRead"
          }
        }
      }
    },
    "allowDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/stringSet"
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/filePath"
              },
              "uniqueItems": true
            }
          }
        },
        "cli": {
          "$ref": "#/$defs/stringSet"
        },
        "agents": {
          "$ref": "#/$defs/stringSet"
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ask": {
              "type": "boolean"
            },
            "decide": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "workerBinding": {
      "type": "object",
      "required": ["prompt", "contract", "mode"],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "$ref": "#/$defs/registryPath"
        },
        "contract": {
          "$ref": "#/$defs/registryPath"
        },
        "mode": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "receiptSchemas": {
      "oneOf": [
        {
          "$ref": "#/$defs/registrySchemaPath"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/registrySchemaPath"
          },
          "uniqueItems": true
        }
      ]
    },
    "contextBudget": {
      "type": "object",
      "required": ["max_input_chars", "max_summary_chars"],
      "additionalProperties": false,
      "properties": {
        "max_input_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_summary_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nodeDefinition": {
      "type": "object",
      "required": ["id", "kind", "title", "produces"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": ["step", "gate"]
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "produces": {
          "oneOf": [
            {
              "$ref": "#/$defs/stepProduces"
            },
            {
              "$ref": "#/$defs/gateProduces"
            }
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "instructions": {
          "$ref": "#/$defs/registryPath"
        },
        "operations": {
          "$ref": "#/$defs/registryPath"
        },
        "prompt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "decider": {
          "type": "string",
          "enum": ["user", "worker", "engine"]
        },
        "reads": {
          "$ref": "#/$defs/readsDefinition"
        },
        "allow": {
          "$ref": "#/$defs/allowDefinition"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycleHooks"
        },
        "worker": {
          "$ref": "#/$defs/workerBinding"
        },
        "receipts": {
          "$ref": "#/$defs/receiptSchemas"
        },
        "context_budget": {
          "$ref": "#/$defs/contextBudget"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "step"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "produces": {
                "$ref": "#/$defs/stepProduces"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["prompt"]
                },
                {
                  "required": ["decider"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "step"
              },
              "id": {
                "not": {
                  "const": "shape.intake"
                }
              }
            },
            "required": ["kind", "id"]
          },
          "then": {
            "required": ["instructions"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gate"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["prompt", "decider"],
            "properties": {
              "produces": {
                "$ref": "#/$defs/gateProduces"
              }
            },
            "not": {
              "required": ["instructions"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "decider": {
                "const": "worker"
              }
            },
            "required": ["decider"]
          },
          "then": {
            "required": ["worker"]
          }
        }
      ]
    },
    "connectionSelectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["completed", "not_applicable", "disqualified"]
          },
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "connectionDefinition": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "on": {
          "$ref": "#/$defs/connectionSelectors"
        },
        "loop": {
          "$ref": "#/$defs/identifier"
        },
        "when": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
