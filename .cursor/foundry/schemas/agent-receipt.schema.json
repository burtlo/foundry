{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/agent-receipt.schema.json",
  "title": "AgentReceipt",
  "description": "Structured output from one subagent invocation. Durable evidence for diagnosis and learning.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "timestamp",
    "agent",
    "status",
    "provenance",
    "recommended_next_state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.2.0" },
    "receipt_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "parent_receipt_id": { "type": ["string", "null"], "format": "uuid" },
    "work_item_id": {
      "type": ["string", "null"],
      "description": "Execution graph node ID when applicable."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "agent": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "story-writer",
            "codebase-researcher",
            "backend-builder",
            "client-builder",
            "feature-builder",
            "implementation-validator",
            "intake-checker",
            "intake-checker.shape",
            "foundry.intake",
            "shape.steward",
            "shape-presenter",
            "shape-recorder",
            "documentation-writer",
            "devops-builder",
            "grilling",
            "planner",
            "bugbot",
            "security-review",
            "repairer"
          ]
        },
        "mode": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial"]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "brief_hash": { "type": "string" },
        "ac_version": { "type": "integer" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40,64}$"
      }
    },
    "context_usage": {
      "type": "object",
      "properties": {
        "packet_chars": { "type": "integer", "minimum": 1 },
        "max_input_chars": { "type": "integer", "minimum": 1 },
        "utilization_percent": { "type": "integer", "minimum": 0 }
      }
    },
    "exploration": {
      "type": "object",
      "properties": {
        "searches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": { "type": "string" },
              "files": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "files_examined": { "type": "array", "items": { "type": "string" } },
        "questions_generated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "why": { "type": "string" },
              "deferred": { "type": "boolean" }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["accepted", "rejected", "unresolved"]
              },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "assumptions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "files_changed": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "summary_markdown": {
          "type": "string",
          "description": "Short verdict line (1–2 sentences). Full assessment lives at assessment_path."
        },
        "assessment_path": {
          "type": "string",
          "description": "Run URI to the worker assessment markdown file, e.g. run:receipts/{visit_id}/assessment.md."
        },
        "intake_receipt_id": {
          "type": "string",
          "format": "uuid",
          "description": "Receipt id of the sealed intake-receipt for this visit (intake-checker contract)."
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer" }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "important": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "open_risks": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "child_receipt_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "CLI-owned origin for step receipts. Parent agents must not set this by hand.",
      "required": ["source", "run_id"],
      "properties": {
        "source": { "type": "string" },
        "cli_command": { "type": "string" },
        "run_id": { "type": "string", "format": "uuid" },
        "launch_id": { "type": "string", "format": "uuid" },
        "step_id": { "type": "string" },
        "agent": { "type": "string" },
        "mode": { "type": "string" },
        "branch_point": { "type": "string" },
        "reviewed_head_sha": { "type": "string" }
      }
    },
    "recommended_next_state": {
      "type": "string",
      "description": "Dotted step ID or BLOCKED_* constant."
    },
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        "ambiguity",
        "missing_knowledge",
        "plan_error",
        "decomposition_error",
        "oversized_context",
        "integration_gap",
        "implementation_mistake",
        "environment_error",
        "process_violation",
        null
      ]
    }
  }
}
