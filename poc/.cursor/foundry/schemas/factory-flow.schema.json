{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/factory-flow.schema.json",
  "title": "FactoryFlowRegistry",
  "description": "JSON Schema for validating factory-flow.yaml structure (YAML parsed to JSON for validation).",
  "type": "object",
  "required": ["version", "flows", "gates", "state_schema"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "state_schema": {
      "type": "string",
      "description": "Relative path to factory-run-state.schema.json"
    },
    "flows": {
      "type": "object",
      "required": ["implementation", "analysis"],
      "additionalProperties": false,
      "properties": {
        "implementation": { "$ref": "#/$defs/flowDefinition" },
        "analysis": { "$ref": "#/$defs/flowDefinition" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gateDefinition" }
    }
  },
  "$defs": {
    "flowDefinition": {
      "type": "object",
      "required": ["entry", "steps", "edges"],
      "properties": {
        "entry": { "type": "string" },
        "steps": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stepDefinition" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeDefinition" }
        }
      }
    },
    "stepDefinition": {
      "type": "object",
      "required": ["title", "unit"],
      "properties": {
        "title": { "type": "string" },
        "unit": {
          "type": "string",
          "description": "Path to step unit markdown relative to .cursor/foundry/"
        },
        "subagent": { "type": ["string", "null"] },
        "subagent_mode": { "type": ["string", "null"] },
        "run_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["implementation", "analysis"]
          }
        },
        "state": { "type": "object" },
        "gate": { "$ref": "#/$defs/gateReference" },
        "when_skip": {
          "type": "array",
          "items": { "type": "string" },
          "description": "CEL-like expressions evaluated against config + state."
        },
        "delivery_gate": { "type": "boolean" },
        "receipt_required": { "type": "boolean" },
        "worker_contract": { "type": "string" },
        "handoff_blurb": { "type": "string", "minLength": 1 },
        "context_budget": {
          "type": "object",
          "required": ["max_input_chars", "max_summary_chars"],
          "properties": {
            "max_input_chars": { "type": "integer", "minimum": 1 },
            "max_summary_chars": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_enter": {
              "type": "array",
              "items": { "enum": ["ensure_execution_graph_reference"] }
            },
            "on_exit": {
              "type": "array",
              "items": { "enum": ["validate_build_exit"] }
            }
          }
        }
      }
    },
    "edgeDefinition": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "when": {
          "type": "string",
          "description": "Expression; default always when omitted."
        },
        "priority": {
          "type": "integer",
          "description": "When multiple edges match, highest priority wins."
        }
      }
    },
    "gateReference": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["human_approval", "human_confirm", "two_turn_stop", "evidence_only"]
        },
        "prompt_key": { "type": "string" },
        "require": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outcomes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["terminal"],
                "properties": { "terminal": { "const": true } },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "gateDefinition": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
