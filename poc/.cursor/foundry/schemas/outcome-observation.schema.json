{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/outcome-observation.schema.json",
  "title": "FoundryOutcomeObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "observed_at",
    "pr_url",
    "checks_total",
    "failed_checks",
    "review_count",
    "snapshot_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "observed_at": { "type": "string", "format": "date-time" },
    "pr_url": { "type": "string", "format": "uri" },
    "state": { "type": ["string", "null"] },
    "merged_at": { "type": ["string", "null"], "format": "date-time" },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "head_sha": { "type": ["string", "null"] },
    "checks_total": { "type": "integer", "minimum": 0 },
    "failed_checks": { "type": "array", "items": { "type": ["string", "null"] } },
    "review_count": { "type": "integer", "minimum": 0 },
    "snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
