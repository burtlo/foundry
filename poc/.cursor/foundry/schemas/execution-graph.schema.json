{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/execution-graph.schema.json",
  "title": "ExecutionGraph",
  "description": "Approved plan decomposing ticket work into nodes, dependencies, owners, and verification.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "run_id",
    "issue_key",
    "risk_tier",
    "approved_ac_version",
    "work_items",
    "verification_plan",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.2.0" },
    "graph_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "issue_key": { "type": "string" },
    "risk_tier": { "type": "string", "enum": ["low", "medium", "high"] },
    "approved_ac_version": { "type": "integer", "minimum": 1 },
    "approved_ac_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Digest of the approved acceptance criteria used to derive this graph."
    },
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash of the approved brief used to derive this graph."
    },
    "topology": {
      "type": "string",
      "enum": ["sequential", "parallel_with_integrator", "single_worker"],
      "description": "How workers coordinate; derived from plan, not fixed thresholds."
    },
    "integrator": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "responsibilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "owner", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "description": { "type": "string" },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["feature", "repair"],
            "description": "feature is the default; repair items are build/test/tooling fixes without AC refs."
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ac_refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs from approved_ac in run state."
          },
          "files_hint": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_required": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "unit-tests",
                "integration-tests",
                "build-pass",
                "validator-clear",
                "security-review",
                "bugbot"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "ready", "in_progress", "completed", "failed", "blocked"]
          },
          "receipt_id": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "after"],
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "implementation-validator",
              "bugbot",
              "security-review",
              "documentation-writer",
              "build",
              "test"
            ]
          },
          "after": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Work item IDs or special tokens: all_work_items, step6_human_approval."
          },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "plan_stability": {
      "type": "object",
      "properties": {
        "changes_after_build_started": { "type": "integer", "minimum": 0 },
        "last_modified_at": { "type": "string", "format": "date-time" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
