{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/factory-config.schema.json",
  "title": "FactoryConfig",
  "description": "Resolved team profile for Software Factory (Foundry).",
  "type": "object",
  "required": [
    "profile_version",
    "team",
    "workspace",
    "jira",
    "git",
    "org",
    "templates",
    "foundry"
  ],
  "additionalProperties": true,
  "properties": {
    "profile_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "intake": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["jira", "local", "chat"],
          "description": "Ticket intake path. Defaults from jira.enabled when omitted."
        },
        "tickets_root": {
          "type": "string",
          "minLength": 1,
          "description": "Directory of local markdown tickets (relative to app_folder by default)."
        }
      }
    },
    "team": {
      "type": "object",
      "required": ["id", "display_name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["app_folders", "resolve_templates_from_org"],
      "additionalProperties": true,
      "properties": {
        "app_folders": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "resolve_templates_from_org": { "type": "boolean" }
      }
    },
    "jira": {
      "type": "object",
      "required": ["enabled", "project_key"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "project_key": { "type": "string", "minLength": 1 }
      }
    },
    "git": {
      "type": "object",
      "required": ["feature_branch_pattern", "pr_title_pattern"],
      "additionalProperties": true,
      "properties": {
        "feature_branch_pattern": { "type": "string", "minLength": 1 },
        "pr_title_pattern": { "type": "string", "minLength": 1 }
      }
    },
    "org": {
      "type": "object",
      "required": ["display_name", "required_labels"],
      "additionalProperties": true,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "required_labels": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "templates": {
      "type": "object",
      "required": ["implement", "add_tests", "run_tests"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "foundry": {
      "type": "object",
      "required": [
        "default_risk_tier_rules",
        "grilling",
        "planner",
        "observability",
        "knowledge"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deprecated no-op; Foundry is always the software factory."
        },
        "default_risk_tier_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "tier"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "tier": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        },
        "grilling": {
          "type": "object",
          "required": ["enabled", "max_rounds", "skip_when_readiness"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "max_rounds": { "type": "integer", "minimum": 0 },
            "skip_when_readiness": { "type": "string", "minLength": 1 }
          }
        },
        "planner": {
          "type": "object",
          "required": ["required_when_risk", "min_work_items"],
          "additionalProperties": false,
          "properties": {
            "required_when_risk": {
              "type": "array",
              "items": { "type": "string", "enum": ["low", "medium", "high"] },
              "uniqueItems": true
            },
            "min_work_items": { "type": "integer", "minimum": 1 }
          }
        },
        "observability": {
          "type": "object",
          "required": ["emit_receipts", "emit_events"],
          "additionalProperties": false,
          "properties": {
            "emit_receipts": { "type": "boolean" },
            "emit_events": { "type": "boolean" }
          }
        },
        "knowledge": {
          "type": "object",
          "required": ["auto_suggest", "require_human_promotion"],
          "additionalProperties": false,
          "properties": {
            "auto_suggest": { "type": "boolean" },
            "require_human_promotion": { "type": "boolean" }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dependency_summary_token_budget": { "type": "integer", "minimum": 1 },
            "validator_loop_threshold": { "type": "integer", "minimum": 1 },
            "builder_to_bugbot_loop_threshold": { "type": "integer", "minimum": 1 }
          }
        },
        "orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strict_mode": { "type": "boolean" },
            "stop_on_tooling_failure": { "type": "boolean" },
            "stop_on_receipt_anomaly": { "type": "boolean" },
            "forbid_parent_app_edits": { "type": "boolean" },
            "thin_context": { "type": "boolean" },
            "allow_force_unblock": { "type": "boolean" },
            "allow_raw_dotnet_commands": { "type": "boolean" },
            "default_interaction_mode": {
              "type": "string",
              "enum": ["interactive", "drive_to_pr", "plan_control"]
            },
            "require_integrity_check": {
              "type": "boolean",
              "description": "When true, integrity-check must pass before ship / handoff completion."
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_pr_verification": { "type": "boolean" }
          }
        }
      }
    }
  }
}
