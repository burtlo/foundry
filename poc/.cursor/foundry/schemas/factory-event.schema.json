{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/factory-event.schema.json",
  "title": "FactoryEvent",
  "description": "Append-only audit event for one factory run. Stored as JSONL (one object per line).",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "timestamp",
    "event_type",
    "actor"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.2.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "State transaction associated with this event when one exists."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": {
      "type": "string",
      "enum": [
        "run_started",
        "run_completed",
        "run_aborted",
        "run_abandoned",
        "state_transition",
        "gate_presented",
        "gate_resolved",
        "subagent_launched",
        "subagent_completed",
        "subagent_failed",
        "cli_invoked",
        "cli_failed",
        "evidence_recorded",
        "blocked",
        "unblocked",
        "failure_classified",
        "human_override",
        "session_started",
        "handoff_written",
        "learning_finalized",
        "external_operation"
      ]
    },
    "actor": {
      "type": "string",
      "enum": ["parent", "human", "engine", "subagent", "cli"]
    },
    "step_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z]+\\.[a-z_]+$"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data; see event_type.",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "state_transition" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["from_step", "to_step", "evidence_refs"],
            "properties": {
              "from_step": { "type": "string" },
              "to_step": { "type": "string" },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rule_id": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "gate_resolved" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["gate_kind", "decision"],
            "properties": {
              "gate_kind": {
                "type": "string",
                "enum": ["human_approval", "human_confirm", "two_turn_stop"]
              },
              "decision": { "type": "string" },
              "wait_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "failure_classified" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["failure_class"],
            "properties": {
              "failure_class": {
                "type": "string",
                "enum": [
                  "ambiguity",
                  "missing_knowledge",
                  "plan_error",
                  "decomposition_error",
                  "oversized_context",
                  "integration_gap",
                  "implementation_mistake",
                  "environment_error",
                  "process_violation"
                ]
              },
              "source_step_id": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "external_operation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["integration", "operation", "target", "status"],
            "properties": {
              "integration": { "enum": ["github", "jira", "confluence"] },
              "operation": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "status": { "enum": ["prepared", "succeeded", "failed", "skipped", "reconciled"] },
              "operation_id": { "type": "string", "format": "uuid" },
              "request_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "attempt": { "type": "integer", "minimum": 1 },
              "remote_id": { "type": ["string", "null"] },
              "evidence": { "type": "object" }
            }
          }
        }
      }
    }
  ]
}
