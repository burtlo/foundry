{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/packets/learning-record.schema.json",
  "title": "FoundryLearningRecord",
  "description": "Offline post-run learning record. Never load into the next steward chat.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "issue_key",
    "app_folder",
    "interaction_mode",
    "outcome",
    "required_fields",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.2.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "issue_key": { "type": ["string", "null"] },
    "app_folder": { "type": "string" },
    "interaction_mode": {
      "type": "string",
      "enum": ["interactive", "drive_to_pr", "plan_control"]
    },
    "resolved_profile_hash": { "type": ["string", "null"] },
    "foundry_git_sha": { "type": ["string", "null"] },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "abandoned", "blocked"]
        },
        "pr_url": { "type": ["string", "null"] },
        "duration_ms": { "type": ["integer", "null"] },
        "abandon_reason": { "type": ["string", "null"] }
      }
    },
    "rework": { "type": "object" },
    "failure_class_distribution": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "gate_source_histogram": {
      "type": "object",
      "additionalProperties": { "type": "integer" },
      "description": "Counts of human vs auto gate resolutions"
    },
    "auto_gate_overturns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": { "type": "string" },
          "auto_decision": { "type": "string" },
          "human_decision": { "type": "string" }
        }
      }
    },
    "session_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" },
          "intent": { "type": "string" },
          "start_step": { "type": "string" },
          "stop_step": { "type": "string" }
        }
      }
    },
    "seam_friction": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": { "type": "string" },
          "rework_loops": { "type": "integer" },
          "gate_wait_ms": { "type": ["integer", "null"] }
        }
      }
    },
    "assumption_ledger": {
      "type": "array",
      "items": { "type": "string" }
    },
    "critic_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "critic_taxonomy": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "escaped_defects": {
      "type": "array",
      "items": { "type": "object" }
    },
    "seams": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reliability_in_scope": { "type": ["boolean", "null"] },
    "subagent_invocations": { "type": "object" },
    "required_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Which MVP fields were populated"
    },
    "best_effort": {
      "type": "object",
      "additionalProperties": true
    },
    "observed_outcome": {
      "type": "object",
      "description": "Offline PR checks and merge-state observation linked to this run."
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
