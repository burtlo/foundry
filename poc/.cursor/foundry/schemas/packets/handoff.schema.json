{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/packets/handoff.schema.json",
  "title": "FoundryHandoff",
  "description": "Machine twin for handoff.md frontmatter + kickoff. Cap human body separately (~40-60 lines).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "current_step",
    "interaction_mode",
    "app_folder",
    "kickoff_prompt",
    "updated_at",
    "conversation_checkpoint"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.2.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "issue_key": { "type": ["string", "null"] },
    "app_folder": { "type": "string" },
    "run_dir": { "type": "string" },
    "state_path": { "type": "string" },
    "current_step": { "type": "string" },
    "interaction_mode": {
      "type": "string",
      "enum": ["interactive", "drive_to_pr", "plan_control"]
    },
    "blocked": { "type": ["object", "null"] },
    "feature_branch": { "type": ["string", "null"] },
    "what_happened": { "type": "string", "maxLength": 2000 },
    "what_next": { "type": "string", "maxLength": 2000 },
    "kickoff_prompt": { "type": "string" },
    "next_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "conversation_checkpoint": {
      "type": "object",
      "required": ["required", "source_conversation_id"],
      "properties": {
        "required": { "type": "boolean" },
        "source_conversation_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
