{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/packets/worker-launch-packet.schema.json",
  "title": "FoundryWorkerLaunchPacket",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "launch_id",
    "step_id",
    "agent",
    "mode",
    "config",
    "inputs",
    "allowed_writes",
    "craft_staging_path",
    "contract_refs",
    "prompt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.2.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "launch_id": { "type": "string", "format": "uuid" },
    "receipt_id": { "type": "string", "format": "uuid" },
    "step_id": { "type": "string" },
    "work_item_id": { "type": ["string", "null"] },
    "agent": { "type": "string" },
    "mode": { "type": "string" },
    "config": { "type": "object" },
    "inputs": {
      "type": "object",
      "description": "Bounded step inputs and paths; never complete event or receipt history."
    },
    "allowed_writes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "craft_staging_path": { "type": "string" },
    "named_artifact_path": { "type": ["string", "null"] },
    "contract_refs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "context_budget": {
      "type": "object",
      "required": ["max_input_chars", "max_summary_chars"],
      "properties": {
        "max_input_chars": { "type": "integer", "minimum": 1 },
        "max_summary_chars": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "context_usage": {
      "type": "object",
      "required": ["packet_chars", "max_input_chars", "utilization_percent"],
      "properties": {
        "packet_chars": { "type": "integer", "minimum": 1 },
        "max_input_chars": { "type": "integer", "minimum": 1 },
        "utilization_percent": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "redacted_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40,64}$"
      }
    },
    "prompt": { "type": "string", "minLength": 1 }
  }
}
