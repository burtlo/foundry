{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/packets/agent-craft.schema.json",
  "title": "AgentCraftOverlay",
  "description": "Craft-only fields a worker may write (staging/{launch_id}.craft.json). Engine owns identity fields on the durable receipt.",
  "type": "object",
  "required": ["schema_version", "status", "outputs", "recommended_next_state"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.2.0" },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "blocked", "partial"]
    },
    "outputs": { "type": "object" },
    "exploration": { "type": "object" },
    "decisions": { "type": "array" },
    "commands": { "type": "array" },
    "blockers": { "type": "array" },
    "recommended_next_state": { "type": "string" },
    "state_patch": { "type": "object" },
    "parent_receipt_id": { "type": ["string", "null"], "format": "uuid" }
  }
}
