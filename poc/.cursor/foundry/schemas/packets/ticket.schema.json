{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schemas/packets/ticket.schema.json",
  "title": "FoundrySealedTicket",
  "description": "Sealed ticket packet written to {run_dir}/ticket.json. Source of truth for the run after ingest.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "body",
    "acceptance_criteria",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "type": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "app": { "type": ["string", "null"] },
    "app_hint": { "type": ["string", "null"] },
    "source": {
      "type": "string",
      "enum": ["local_file", "paste", "jira"]
    },
    "source_path": { "type": ["string", "null"] },
    "sealed_at": { "type": "string", "format": "date-time" }
  }
}
